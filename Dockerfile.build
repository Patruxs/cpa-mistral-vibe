# syntax=docker/dockerfile:1
# Build the plugin shared library for the host platform:
#   docker build --file Dockerfile.build --output type=local,dest=dist .
FROM golang:1.26-bookworm AS build
WORKDIR /src
RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev \
    && rm -rf /var/lib/apt/lists/*
COPY go.mod ./
COPY cmd ./cmd
ENV CGO_ENABLED=1 GOOS=linux
RUN mkdir /out && go build -trimpath -buildvcs=false -buildmode=c-shared \
    -ldflags='-s -w' -o /out/cpa-mistral-vibe.so ./cmd/cpa-mistral-vibe

FROM scratch AS artifact
COPY --from=build /out/cpa-mistral-vibe.so /cpa-mistral-vibe.so
